# ECC68 Lab environment template — no secrets committed.

# Transport: stdio (Cursor local) | http (Streamable HTTP on localhost)
ECC68_TRANSPORT=stdio

# Shared CPU runtime concurrency (default 2)
ECC68_CONCURRENCY=2

# Durable storage
ECC68_DATA_DIR=./data
ECC68_DB_PATH=./data/ecc68.sqlite
ECC68_WORKSPACES_DIR=./workspaces

# Task limits
ECC68_MAX_STEPS=12
ECC68_TASK_TIMEOUT_MS=120000

# Free OpenAI-compatible model endpoint (optional).
# If unset: live model PASS is BLOCKED; heuristic orchestration still works.
# Examples: local Ollama / LM Studio / other free OpenAI-compatible servers.
ECC68_MODEL_URL=
ECC68_MODEL_NAME=free-local
ECC68_MODEL_API_KEY=

# Required when ECC68_TRANSPORT=http (Bearer token). Never commit real tokens.
ECC68_AUTH_TOKEN=
ECC68_HOST=127.0.0.1
ECC68_PORT=8787
ECC68_ALLOW_ORIGINS=http://127.0.0.1,http://localhost

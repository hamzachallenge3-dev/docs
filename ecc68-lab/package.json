{
  "name": "ecc68-lab",
  "version": "1.0.0",
  "description": "ECC 68 authenticated MCP plugin with chief-of-staff routing",
  "main": "dist/index.js",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "build": "tsc",
    "start": "node --experimental-sqlite dist/index.js",
    "start:stdio": "ECC68_TRANSPORT=stdio node --experimental-sqlite dist/index.js",
    "start:http": "ECC68_TRANSPORT=http node --experimental-sqlite dist/index.js",
    "dev": "ECC68_TRANSPORT=stdio npx tsx --experimental-sqlite src/index.ts",
    "test": "node --experimental-sqlite --import tsx node_modules/vitest/vitest.mjs run",
    "test:watch": "node --experimental-sqlite --import tsx node_modules/vitest/vitest.mjs",
    "check:registry": "npx tsx --experimental-sqlite scripts/check-registry.ts"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "express": "^5.3.0",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  },
  "type": "module",
  "bin": {
    "ecc68-mcp": "dist/index.js"
  },
  "engines": {
    "node": ">=22"
  }
}